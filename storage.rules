rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny all public & unauthenticated access
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // User's private audio uploads
    match /users/{uid}/audio/{fileName} {
      // Read access: Strictly private to the owning user
      allow read: if request.auth != null && request.auth.uid == uid;

      // Write access (Upload / Update / Delete)
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   // Enforce audio MIME type only (e.g. audio/mpeg, audio/flac, audio/wav, audio/aac, audio/mp4)
                   && request.resource.contentType.matches('audio/.*')
                   // Enforce maximum file size limit of 100 MB (104,857,600 bytes)
                   && request.resource.size <= 104857600;
    }
  }
}
